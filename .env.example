# Public canonical origin. Set the real HTTPS domain BEFORE npm run build.
SITE_URL=http://localhost:3000
# Writable directory outside public/. Use /var/lib/hakhamanesh/requests on Linux.
DATA_DIR=./runtime/requests
# Generated by npm run setup. Keep securely backed up; never use NEXT_PUBLIC_ here.
LEADS_ENCRYPTION_KEY=
# Set 1 ONLY behind a proxy that overwrites X-Real-IP / X-Forwarded-Host.
TRUST_PROXY=0
# Optional real social URLs. Empty values show an honest unavailable message.
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_TELEGRAM_URL=
NEXT_PUBLIC_WHATSAPP_URL=
